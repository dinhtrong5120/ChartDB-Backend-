# Local Windows/macOS development settings for importing schema from MySQL.
# Copy this file to .env.local and set the source database username/password.
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
SOURCE_DB_HOST=127.0.0.1
SOURCE_DB_PORT=3306
SOURCE_DB_NAME=chartdb
SOURCE_DB_USER=replace-with-your-mysql-user
SOURCE_DB_PASSWORD=replace-with-your-mysql-password
